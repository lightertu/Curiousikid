# List all available recipes
default:
    @just --list

# Set strict shell options for all recipes
set shell := ["bash", "-eux", "-c"]

# Update AWS credentials
auth:
    ~/.toolbox/bin/ada credentials update --account=026090537351 --provider=conduit --role=IibsAdminAccess-DO-NOT-DELETE --once
    export AWS_DEFAULT_REGION='us-east-1'

# Remove virtual environment
clean:
    rm -rf .venv

# Check for required external dependencies
check-deps:
    set -eu
    @command -v pyenv >/dev/null || (echo "Error: pyenv not found. Please install pyenv (https://github.com/pyenv/pyenv#installation)." && exit 1)
    @command -v ffmpeg >/dev/null || (echo "Error: ffmpeg not found. Please install ffmpeg (e.g., 'brew install ffmpeg' or 'sudo apt install ffmpeg')." && exit 1)
    @command -v livekit-server >/dev/null || (echo "Error: livekit-server not found. Please install livekit-server (https://docs.livekit.io/oss/deployment/deploy-options/#local)." && exit 1)

install: check-deps
    #!/usr/bin/env bash
    set -eu
    # Check if pyenv version 3.12 is installed, if not, install it
    # (Assuming pyenv is now confirmed to exist by check-deps)
    echo "Creating virtual environment..."
    python -m venv .venv
    echo "Upgrading pip..."
    .venv/bin/pip install --upgrade pip
    echo "Installing dependencies using uv..."
    # Install uv inside the venv first if needed, then sync
    .venv/bin/python -m pip install uv
    .venv/bin/uv sync
    echo "Installation complete. Activate venv with: source .venv/bin/activate"

serve:
    @echo "Starting FastAPI server on http://0.0.0.0:8000"
    @.venv/bin/python -m src.control_server

serve-agent:
    .venv/bin/python src/voice_agent/entrypoint.py dev

serve-livekit: check-deps
    livekit-server --dev --bind 0.0.0.0

warm-memory:
    .venv/bin/python src/memory/warm_start_memories.py --file /Users/paruchua/Documents/Curiousikid/backend/src/memory/emma_persona.json
