# List all available recipes
default:
    @just --list

# Set strict shell options for all recipes
set shell := ["bash", "-eux", "-c"]

# Remove node_modules directory
clean:
    rm -rf node_modules

reinstall:
    #!/usr/bin/env bash
    just clean install

# Install dependencies
install:
    #!/usr/bin/env bash
    set -eu
    if [ ! -d "$HOME/.nvm" ]; then 
        curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.5/install.sh | bash
        export NVM_DIR="$HOME/.nvm" 
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    fi

    # Load nvm
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

    # Install Node.js 16 and use it
    nvm install 18
    nvm use 18
    
    # Install yarn if not already installed
    if ! command -v yarn &> /dev/null; then
        npm install -g yarn
    fi

    # Install dependencies
    yarn install

# Run TypeScript type checking
typecheck:
    #!/usr/bin/env bash
    set -eu
    # Load nvm
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    
    # Use Node.js 16
    nvm use 16
    
    # Install yarn if not already installed
    if ! command -v yarn &> /dev/null; then
        npm install -g yarn
    fi
    
    # Run TypeScript type checking
    yarn tsc --noEmit

# Convert project to TypeScript
convert_to_typescript:
    #!/usr/bin/env bash
    set -eu
    
    # Load nvm
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    
    # Use Node.js 16
    nvm use 16
    
    # Install yarn if not already installed
    if ! command -v yarn &> /dev/null; then
        npm install -g yarn
    fi
    
    # Install TypeScript and necessary type definitions
    yarn add typescript @types/node @types/react @types/react-dom @types/jest @types/styled-components @types/uuid
    
    # Create tsconfig.json
    echo '{
      "compilerOptions": {
        "target": "es5",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx"
      },
      "include": ["src"]
    }' > tsconfig.json
    
    # Rename JavaScript files to TypeScript
    find src -name "*.js" -not -path "*/node_modules/*" -exec sh -c 'new_file="${1%.js}.tsx"; echo "Converting $1 to $new_file"; cp "$1" "$new_file"' _ {} \;
    
    # Rename non-React JS files to TS instead of TSX
    if [ -f "src/data.tsx" ]; then
        mv src/data.tsx src/data.ts
    fi
    
    if [ -f "src/reportWebVitals.tsx" ]; then
        mv src/reportWebVitals.tsx src/reportWebVitals.ts
    fi
    
    # Update package.json to recognize TypeScript
    if command -v jq &> /dev/null; then
        jq '.dependencies += {"typescript": "^4.9.5"}' package.json > package.json.tmp && mv package.json.tmp package.json
    else
        echo "jq not installed, please manually add typescript to package.json"
    fi
    
    echo "TypeScript conversion complete. You now need to manually update the file contents to add types."

# Start the development server
start: 
    #!/usr/bin/env bash
    set -eu
    # Load nvm
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    
    # Use Node.js 18
    nvm use 18
    
    # Install yarn if not already installed
    if ! command -v yarn &> /dev/null; then
        npm install -g yarn
    fi
    
    yarn start 