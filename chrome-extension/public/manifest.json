{
  "manifest_version": 3,
  "name": "LiveKit Voice Conversation",
  "version": "0.1.0",
  "description": "Starts a voice conversation using LiveKit in a sidebar.",
  "options_ui": {
    "page": "options.html"
  },
  "action": {
    "default_title": "Start Voice Conversation"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/contentScript.js"
      ]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {}
}